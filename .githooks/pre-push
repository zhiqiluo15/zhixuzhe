#!/bin/sh
# 智序者 · Git pre-push 钩子：调用开源守卫，拦截私有内容推送
# 由 git push 自动执行；守卫逻辑在 scripts/guard_push.py
# 注意：Windows 上无 python3 命令，这里显式用项目 .venv 的 Python

ROOT=$(git rev-parse --show-toplevel)
GUARD="$ROOT/scripts/guard_push.py"
PY="$ROOT/.venv/Scripts/python.exe"

if [ -x "$PY" ]; then
    exec "$PY" "$GUARD" "$@"
fi

# 兜底：系统 python / py
if command -v python >/dev/null 2>&1; then
    exec python "$GUARD" "$@"
fi

echo "⚠️  开源守卫无法运行（未找到 Python），拒绝推送。请先安装 .venv 或 python。"
exit 1
