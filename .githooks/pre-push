#!/usr/bin/env python3
"""智序者 · Git pre-push 钩子：调用开源守卫，拦截私有内容推送。

作为 .githooks/pre-push 使用（无 .py 后缀也可，git 用解释器运行）。

用法（在仓库根目录执行一次）：
  git config core.hooksPath .githooks

逻辑：
  - 解析 stdin 的推送计划（<local_ref> <local_oid> <remote_ref> <remote_oid>）
  - 把 push 请求转给 scripts/guard_push.py 校验
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GUARD = ROOT / "scripts" / "guard_push.py"


def main() -> int:
    # 读取 stdin 推送计划
    stdin_data = sys.stdin.read()

    if not GUARD.exists():
        print("⚠️  未找到开源守卫脚本 scripts/guard_push.py，本次推送未校验")
        return 1

    proc = subprocess.run(
        [sys.executable, str(GUARD), *sys.argv[1:]],
        input=stdin_data,
        capture_output=True,
        text=True,
    )
    if proc.stdout:
        print(proc.stdout)
    if proc.stderr:
        print(proc.stderr, file=sys.stderr)
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main())
